{
  "name": "edge-mock",
  "version": "1.0.0",
  "description": "Universal Local Edge Function Mocker — test serverless edge functions & webhooks locally without Docker",
  "main": "dist/index.js",
  "bin": {
    "edge-mock": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --outfile=dist/index.js --format=cjs --packages=external --target=node18",
    "start": "node dist/index.js",
    "dev": "node dist/index.js --file test/hello.ts --port 3000"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "edge-functions",
    "webhooks",
    "serverless",
    "local-testing",
    "cli",
    "supabase",
    "deno",
    "mock"
  ],
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
